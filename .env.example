# Copy to .env and fill in. Never commit .env.

# MySQL — Docker Compose reads these (see docker-compose.yml). Bind host port to localhost only.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bradapp
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST_PORT=3306

# App connection string (shape only — replace USER/PASSWORD for your environment):
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/bradapp
DATABASE_URL=

# Required for signed session cookies
SESSION_SECRET=

# API
API_PORT=5174
CORS_ORIGIN=http://127.0.0.1:5173

# Optional: create Brad admin on first API boot when the user is missing
# (hashed at runtime; never overwrite an existing password_hash; never commit)
# BRAD_ADMIN_PASSWORD=
# SEED_BRAD_ADMIN_PASSWORD=

# Optional: seed Napwood super_admin on first API boot (hashed at runtime; never logged)
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_SUPER_ADMIN_NAME=Napwood

# Optional: shared password for seeded demo family members (hashed at seed; never commit)
# DEMO_MEMBER_PASSWORD=

# Optional: permanent demo invite code seeded when Brad exists (never commit a real code)
# DEMO_FAMILY_INVITE_CODE=

# Optional: Brad Coins credited on new member sign-up (ledger reason seed). Default 100.
# MEMBER_STARTING_COINS=100

# Frontend (empty uses Vite proxy to the API in dev)
VITE_API_URL=

# Optional override for review video storage (default: api/data/videos)
# VIDEO_STORAGE_DIR=
